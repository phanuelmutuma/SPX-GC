{
  "name": "spx-gc",
  "version": "1.4.2",
  "description": "SPX Graphics Controller",
  "homepage": "https://spxgraphics.com",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "views/**/*",
      "static/**/*"
    ],
    "outputPath": "dist/pkg",
    "public": true,
    "publicPackages": [
      "*"
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "devORG": "nodemon server.js -i config.json -i DATAROOT/",
    "dev": "nodemon",
    "devdemo": "nodemon server.js config_demodataroot.json",
    "dev2": "nodemon server.js config2.json",
    "start": "node server.js",
    "start:pm2": "pm2 start server.js --name GC",
    "stop": "pm2 stop server.js",
    "build": "node scripts/build-desktop.js macos",
    "build:macos": "node scripts/build-desktop.js macos",
    "build:macos:arm64": "node scripts/build-desktop.js macos-arm64",
    "build:macos:x64": "node scripts/build-desktop.js macos-x64",
    "build:windows": "node scripts/build-desktop.js windows",
    "build:linux": "node scripts/build-desktop.js linux",
    "build:all": "node scripts/build-desktop.js all"
  },
  "keywords": [],
  "author": "Tuomo Kulomaa <tuomo@spxgraphics.com> (https://spxgraphics.com)",
  "license": "MIT",
  "dependencies": {
    "axios": "^0.30.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-handlebars": "^8.0.1",
    "express-session": "^1.18.1",
    "glob": "^11.0.0",
    "ip": "^2.0.1",
    "jsdom": "^25.0.1",
    "macaddress": "^0.5.1",
    "moment": "^2.29.4",
    "morgan": "^1.9.1",
    "node-html-parser": "^6.1.13",
    "node-wav-player": "^1.0.0",
    "node-xlsx": "^0.24.0",
    "open": "^10.1.0",
    "openurl": "^1.1.1",
    "osc": "^2.4.5",
    "path": "^0.12.7",
    "rotating-file-stream": "^3.2.5",
    "socket.io": "^4.8.0",
    "sox-play": "0.0.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@yao-pkg/pkg": "^6.5.1",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
